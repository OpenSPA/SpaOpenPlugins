msgid ""
"New version found.\n"
"Current version: %s\n"
"New version: %s\n"
"Do you want to install?"
msgstr ""
"Nueva versión encontrada.\n"
"Versión actual: %s\n"
"Versión nueva: %s\n"
"¿Quieres instalar?"

msgid "NeedsLogin"
msgstr "Necesita iniciar sesión"

msgid "Last version installed"
msgstr "Ya tienes la última versión instalada"

msgid ""
"1. Click in \"Generate access token\" in your Tailscale web session.\n"
"2. Enter your generated key in /etc/keys/tailscale_api.key"
msgstr ""
"1. Haga clic en \"Generate access token\" en su sesión web de Tailscale.\n"
"2. Ingrese la clave generada en /etc/keys/tailscale_api.key"

msgid ""
"Could not get the list of devices on your network.\n"
"\n"
"To display the devices in your Tailscale network you must:\n"
"1. Delete if an old key exists in your Tailscale web session\n"
"2. Click in \"Generate access token\" in your Tailscale web session\n"
"3. Enter your generated key in /etc/keys/tailscale_api.key."
msgstr ""
"No se pudo obtener la lista de dispositivos en su red.\n"
"\n"
"Para visualizar los dispositivos en su red de Tailscale, debe:\n"
"1. Eliminar si existe una clave antigua en su sesión web de Tailscale\n"
"2. Hacer clic en \"Generate access token\" en su sesión web de Tailscale\n"
"3. Ingresar la clave generada en /etc/keys/tailscale_api.key."

msgid ""
"1. Enter your key by pressing BLUE or entering it manually in the file /etc/keys/tailscale.key\n"
"2. Press YELLOW button.\n"
"3. Press \"OK\".\n"
"Wait a few seconds until it shows \"Running\"."
msgstr ""
"1. Ingrese su clave pulsando AZUL o ingresándola manualmente en el archivo /etc/keys/tailscale.key\n"
"2. Pulse el botón AMARILLO.\n"
"3. Pulse \"OK\".\n"
"Espere unos segundos hasta que muestre \"Funcionando\"."

msgid "Running"
msgstr "Funcionando"

msgid ""
"Your receiver needs to reboot\n"
"Do you want to do it now?"
msgstr ""
"Su receptor necesita reiniciar\n"
"¿Quieres hacerlo ahora?"

msgid "Zero Trust identity-based connectivity"
msgstr "Conectividad Zero Trust basada en la identidad"
